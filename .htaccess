# =============================================================
# SVSML-ERP root .htaccess
# Designed for GoDaddy / cPanel shared hosting on a dedicated
# subdomain whose document root is set to this directory
# (e.g. public_html/erp.seavoyageship.com/  ->  https://erp.seavoyageship.com/).
# Cloudflare-compatible: no rules here interfere with proxying.
# =============================================================

# No directory listings
Options -Indexes
Options +FollowSymLinks

# Default index
DirectoryIndex index.php index.html

# UTF-8 output
AddDefaultCharset UTF-8

# Hide server version info
ServerSignature Off

# -------------------------------------------------------------
# Block direct access to dotfiles + sensitive files at the root
# -------------------------------------------------------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "^(composer\.json|composer\.lock|README\.md)$">
    Require all denied
</FilesMatch>

# -------------------------------------------------------------
# Rewrite scoping
#
# This subdomain is dedicated to the ERP, so RewriteBase is
# the document root "/". The "file/dir exists -> stop" rule
# below guarantees real ERP files (PHP, CSS, JS, uploads) are
# served as-is — important when the parent cPanel account
# already hosts other sites whose .htaccess rules might be
# inherited via UserDir / VirtualHost configuration.
#
# If you redeploy under a subfolder later, edit RewriteBase
# below AND BASE_URL in config/app.php.
# -------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # If the request maps to a real file or directory, serve it
    # and stop processing further rewrite rules.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>
